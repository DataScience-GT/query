---
import HomeSections from "@query/event-kit/components/HomeSections.astro";
import MlhBadge from "@query/event-kit/components/MlhBadge.astro";
import event from "../event.config";
import Layout from "../layouts/Layout.astro";
---

<Layout home>
  <main class="relative w-full overflow-x-hidden">
    {/* TODO: this hero is a placeholder. Replace it with the edition's own. */}
    <section class="relative flex min-h-[100svh] flex-col">
      <MlhBadge event={event} />
      <div class="wrap relative z-20 flex flex-1 flex-col items-center justify-center pt-28 pb-16 text-center md:pt-40">
        <p class="kicker text-[17px] leading-7 text-ink md:text-[20px]">
          {event.dates.short} · {event.venue.name}
        </p>
        <h1 class="display mt-4 text-balance text-[48px] sm:text-[96px] lg:text-[128px]">{event.brand}</h1>
        <p class="mt-6 max-w-[40ch] font-sans text-[17px] leading-[1.55] text-ink-2 md:text-[19px]">
          {event.seo.summary}
        </p>
        <div class="mt-8">
          <a
            href={event.registration.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-bloom"
          >
            {event.registration.label}
          </a>
        </div>
      </div>
    </section>
    <HomeSections event={event} />
  </main>
</Layout>
