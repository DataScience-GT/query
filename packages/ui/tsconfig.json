{
  "extends": "@query/tsconfig/internal-package.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "rootDir": "src",
    "types": [
      "react"
    ],
    "skipLibCheck": true,
    "emitDeclarationOnly": false,
    "module": "ESNext",
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}