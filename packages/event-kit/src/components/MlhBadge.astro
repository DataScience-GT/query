---
import type { EventConfig } from "../config";

interface Props {
  event: EventConfig;
}
const { event } = Astro.props;
// Hangs from the top right of the page it sits on, which must be `relative`.
---

<a
  href={event.links.mlh}
  target="_blank"
  rel="noopener noreferrer"
  class="mlh-badge absolute top-0 right-5 md:right-12 z-50 w-[9%] max-w-[90px] min-w-[56px] hover:opacity-85 transition-opacity duration-150 ease-(--ease)"
>
  <img src="/mlh-trust-badge.svg" alt={`Major League Hacking ${event.year}`} class="w-full" />
</a>
