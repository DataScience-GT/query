{
  "name": "@query/db",
  "version": "4.4.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants/index.ts",
    "./services/membership": "./src/services/membership.ts",
    "./services/pricing": "./src/services/pricing.ts",
    "./services/auth-throttle": "./src/services/auth-throttle.ts"
  },
  "scripts": {
    "migrate:push": "query-guard-local && drizzle-kit push",
    "db:check": "tsx scripts/check-drift.mts",
    "migrate:generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "db:seed": "query-guard-local && tsx scripts/seed-local.ts",
    "db:seed:club-projects": "query-guard-local && tsx scripts/seed-club-projects.ts",
    "export:clickhouse": "tsx scripts/export-clickhouse.mts",
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@query/core": "workspace:*",
    "@t3-oss/env-nextjs": "0.13.11",
    "drizzle-orm": "catalog:",
    "next-auth": "catalog:",
    "pg": "8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@query/oxlint-config": "workspace:*",
    "@query/scripts": "workspace:*",
    "@query/tsconfig": "workspace:*",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "1.0.0-rc.6",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
