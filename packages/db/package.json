{
  "name": "@query/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants/index.ts",
    "./services/membership": "./src/services/membership.ts"
  },
  "scripts": {
    "migrate:push": "node ../../tooling/scripts/src/guard-local.ts && drizzle-kit push",
    "db:check": "tsx scripts/check-drift.mts",
    "migrate:generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "db:seed": "node ../../tooling/scripts/src/guard-local.ts && tsx scripts/seed-local.ts",
    "db:seed:club-projects": "node ../../tooling/scripts/src/guard-local.ts && tsx scripts/seed-club-projects.ts",
    "export:clickhouse": "tsx scripts/export-clickhouse.mts",
    "lint": "oxlint .",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "0.13.11",
    "drizzle-orm": "catalog:",
    "next-auth": "catalog:",
    "pg": "8.23.0",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@query/oxlint-config": "workspace:*",
    "@query/tsconfig": "workspace:*",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
