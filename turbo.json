{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "stream",
  "boundaries": {
    "tags": {
      "core": {
        "dependencies": { "deny": ["app", "service", "data", "ui", "static"] }
      },
      "data": { "dependencies": { "deny": ["service", "ui", "app"] } },
      "ui": { "dependencies": { "deny": ["data", "service", "app"] } },
      "service": { "dependencies": { "deny": ["ui", "app"] } },
      "static": { "dependencies": { "deny": ["data", "service"] } },
      "app": { "dependents": { "deny": ["app", "service", "data", "ui"] } }
    }
  },
  "tasks": {
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "test/**/*.tsx"
      ],
      "env": ["DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "start": {
      "dependsOn": ["^start"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "npm_lifecycle_event",
    "PORT",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "NEXTAUTH_SECRET",
    "AUTH_SECRET",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "STRIPE_SECRET_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_TOKEN",
    "EMAIL_SERVER_HOST",
    "EMAIL_SERVER_PORT",
    "EMAIL_SERVER_USER",
    "EMAIL_SERVER_PASSWORD",
    "EMAIL_FROM",
    "EMAIL_MAX_CONNECTIONS",
    "EMAIL_MAX_MESSAGES",
    "METRICS_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "CACHE_PREFIX",
    "UPSTASH_REDIS_FROM",
    "DB_POOL_MAX",
    "DB_POOL_MIN",
    "CLUB_PROJECT_OWNER_EMAIL",
    "NEXT_RUNTIME",
    "DB_CONNECTION_TIMEOUT_MS",
    "RESUME_BUCKET",
    "BOOTCAMP_BUCKET",
    "AUTH_URL",
    "NEXTAUTH_URL",
    "STRIPE_WEBHOOK_SECRET",
    "TRUSTED_PROXY_HOPS",
    "STRIPE_MOCK_MODE",
    "DDOS_MAX_REQUESTS_PER_MINUTE",
    "DDOS_SUSPICIOUS_THRESHOLD",
    "DDOS_BLOCK_DURATION_MS",
    "DDOS_BURST_THRESHOLD",
    "DDOS_BURST_WINDOW_MS",
    "DDOS_CLEANUP_INTERVAL_MS"
  ]
}
