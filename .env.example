# Local test environment. Copy to .env (pnpm local:up does this for you) and to
# sites/mainweb/.env.local, which is where Next.js looks. Never commit either.
#
# Every default below points at the docker-compose.local.yml services, so a
# fresh checkout touches nothing outside this machine. tooling/scripts/src/guard-local.ts
# refuses to migrate, seed or test against a non-local DATABASE_URL, and refuses
# Stripe live keys outside production.

# --- Database ---------------------------------------------------------------
# Local Postgres from docker-compose.local.yml. Production uses Neon.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/neondb
# Set to 1 only to run migrate/seed/tests against a hosted database on purpose.
# ALLOW_NON_LOCAL_SERVICES=1
# DB_POOL_MAX=20
# DB_CONNECTION_TIMEOUT_MS=3000

# --- Auth -------------------------------------------------------------------
# A fixed throwaway secret: fine here, never reuse it anywhere reachable.
AUTH_SECRET=local-dev-only-secret-do-not-use-elsewhere-0123456789
NEXTAUTH_SECRET=local-dev-only-secret-do-not-use-elsewhere-0123456789
# Must match the origin you open, port included (mainweb dev is 3001).
AUTH_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
# Google and GitHub sign-in need real OAuth apps and are not needed locally:
# sign in with an email code instead (see below). GitHub registers only when
# both of its variables are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: raises the judging repo check GitHub limit from 60 to 5000 requests
# an hour. A token with no scopes is enough for public repos.
GITHUB_TOKEN=

# --- Email ------------------------------------------------------------------
# Mailpit from docker-compose.local.yml. The 6-digit sign-in code and every other
# message is readable at http://localhost:8025 and goes nowhere else.
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=local
EMAIL_SERVER_PASSWORD=local
EMAIL_FROM=noreply@localhost
# EMAIL_MAX_CONNECTIONS=5
# EMAIL_MAX_MESSAGES=100

# --- Stripe -----------------------------------------------------------------
# Mock mode records a paid membership with no network call and needs no key. It
# is ignored when NODE_ENV=production.
STRIPE_MOCK_MODE=true
# To exercise real Stripe Checkout, turn mock mode off and use TEST-MODE keys
# only (sk_test_ / pk_test_). Live keys (sk_live_, rk_live_, pk_live_) are
# refused by the guard. Test cards: https://docs.stripe.com/testing
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (from `stripe listen --forward-to localhost:3001/api/webhooks/stripe`)

# --- Cloud Storage ----------------------------------------------------------
# Resume PDFs and bootcamp workshop ZIPs live in GCS buckets, reached with the
# machine's gcloud credentials. Left unset, uploads and downloads return 503
# instead of touching a real bucket. Do not point these at the club's buckets.
RESUME_BUCKET=
BOOTCAMP_BUCKET=

# --- Optional ---------------------------------------------------------------
# Account that owns the seeded club projects. db:seed sets it for you.
# CLUB_PROJECT_OWNER_EMAIL=admin@example.test
# Python with OR-Tools for the server-side judging scheduler; unset downloads
# the problem and solves it on a laptop instead.
# JUDGING_CPSAT_PYTHON=python3
# Bearer token for /api/metrics. Unset is open outside production.
# METRICS_TOKEN=
# Host ports for docker-compose.local.yml, if the defaults are taken. If you
# change LOCAL_DB_PORT, change DATABASE_URL to match.
# LOCAL_DB_PORT=5434
# LOCAL_SMTP_PORT=1025
# LOCAL_MAILPIT_PORT=8025
