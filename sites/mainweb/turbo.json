{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "next-env.d.ts"
      ],
      "cache": true,
      "env": [
        "PORT",
        "DATABASE_URL",
        "NEXTAUTH_SECRET",
        "AUTH_SECRET",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_SECRET_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_TOKEN",
        "EMAIL_SERVER_HOST",
        "EMAIL_SERVER_PORT",
        "EMAIL_SERVER_USER",
        "EMAIL_SERVER_PASSWORD",
        "EMAIL_FROM",
        "EMAIL_MAX_CONNECTIONS",
        "EMAIL_MAX_MESSAGES",
        "METRICS_TOKEN",
        "DB_POOL_MAX",
        "DB_POOL_MIN",
        "CLUB_PROJECT_OWNER_EMAIL",
        "NEXT_RUNTIME",
        "DB_CONNECTION_TIMEOUT_MS",
        "RESUME_BUCKET",
        "BOOTCAMP_BUCKET",
        "AUTH_URL",
        "NEXTAUTH_URL",
        "STRIPE_WEBHOOK_SECRET",
        "TRUSTED_PROXY_HOPS",
        "STRIPE_MOCK_MODE",
        "DDOS_MAX_REQUESTS_PER_MINUTE",
        "DDOS_SUSPICIOUS_THRESHOLD",
        "DDOS_BLOCK_DURATION_MS",
        "DDOS_BURST_THRESHOLD",
        "DDOS_BURST_WINDOW_MS",
        "DDOS_CLEANUP_INTERVAL_MS"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
