---
import Cloud from "./Cloud.astro";
import Countdown from "./Countdown.tsx";
import Img from "./Img.tsx";
---

<!-- MLH Trust Badge -->
<a
  id="mlh-trust-badge"
  href="https://mlh.io/na?utm_source=na-hackathon&utm_medium=TrustBadge&utm_campaign=2026-season&utm_content=white"
  target="_blank"
  class="absolute top-0 right-4 md:right-[50px] z-50 block w-[10%] max-w-[100px] min-w-[60px] transition-transform hover:scale-110"
>
  <img
    src="https://s3.amazonaws.com/logged-assets/trust-badge/2026/mlh-trust-badge-2026-white.svg"
    alt="Major League Hacking 2026 Hackathon Season"
    class="w-full"
  />
</a>

<!-- Hero Section -->
<div class="relative w-full bg-sky overflow-hidden py-20 md:py-32">
  <!-- Clouds -->
  <Cloud src="/cloud-main/smallCloud.png" class="top-[5%] left-[5%] w-32 h-20 opacity-90 md:w-72 md:h-40" animationDelay="0s" speed="normal" />
  <Cloud src="/cloud-main/smallCloud.png" class="top-[2%] right-[5%] w-24 h-24 opacity-90 md:left-[70%] md:right-auto md:w-40 md:h-40" animationDelay="2.5s" speed="fast" />
  <Cloud src="/cloud-main/midCloud.png" class="hidden md:block md:top-[20%] md:right-[10%] md:w-56 md:h-28 opacity-95" animationDelay="1.8s" speed="slow" />
  <Cloud src="/cloud-main/largecloud.png" class="hidden md:block md:top-[60%] md:left-[5%] md:w-64 md:h-32 opacity-80" animationDelay="3.2s" speed="slow" />

  <!-- Bottom Clouds -->
  <div class="absolute bottom-0 left-0 w-[50%] h-32 -translate-x-1/4 opacity-95 md:h-52 pointer-events-none">
    <Img src="/cloud-main/cloudBottom.png" alt="Decorative cloud" fill className="object-contain" />
  </div>
  <div class="absolute bottom-0 left-0 w-[75%] h-32 -translate-x-[25%] opacity-95 md:h-52 pointer-events-none">
    <Img src="/cloud-main/cloudBottom.png" alt="Decorative cloud" fill className="object-contain" />
  </div>
  <div class="absolute bottom-0 right-0 w-[50%] h-32 translate-x-1/4 opacity-95 md:h-52 pointer-events-none">
    <Img src="/cloud-main/cloudBottom.png" alt="Decorative cloud" fill className="object-contain" />
  </div>
  <div class="absolute bottom-0 right-0 w-[75%] h-32 translate-x-[25%] opacity-95 md:h-52 pointer-events-none">
    <Img src="/cloud-main/cloudBottom.png" alt="Decorative cloud" fill className="object-contain" />
  </div>

  <!-- Static Candies -->
  <div class="absolute bottom-0 left-[2%] w-28 h-28 md:left-[5%] md:w-60 md:h-60 z-30">
    <Img src="/cloud-main/candy/candyEnd.png" alt="Candy left" fill className="object-contain md:scale-150" />
  </div>
  <div class="absolute bottom-0 right-[2%] w-28 h-28 md:right-[5%] md:w-60 md:h-60 z-30">
    <Img src="/cloud-main/candy/candyEnd.png" alt="Candy right" fill className="object-contain md:scale-150" />
  </div>

  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[95%] max-w-lg h-28 z-10 md:z-40 md:w-[55rem] md:h-[23rem] md:max-w-none">
    <Img src="/dsgt.png" alt="DSGT Footer" fill className="object-contain" />
  </div>

  <Cloud src="/cloud-main/dateCloud.png" class="hidden md:block bottom-[45%] left-[15%] w-64 h-32 opacity-95" animationDelay="2.7s" speed="slow" />
  <Cloud src="/cloud-main/DSGTCloud.png" class="hidden md:block bottom-[40%] right-[5%] w-64 h-32 opacity-95" animationDelay="4.1s" speed="normal" />

  <!-- Hero Content -->
  <div class="relative z-10 flex flex-col items-center justify-center text-center px-4 mt-8 min-h-[60vh]">
    <!-- Decorative light burst -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[150%] h-[150%] bg-radial-gradient from-white/40 to-transparent opacity-60 blur-3xl -z-10 pointer-events-none animate-pulse-slow"></div>

    <div class="-mt-4 md:-mt-8">
      <h2 class="truculenta-900 text-5xl md:text-7xl font-black leading-none tracking-tight text-white drop-shadow-[0_4px_0_rgba(165,32,25,0.4)] animate-fade-in-up mb-8">
        Hacklytics 2026
      </h2>

      <div class="relative group">
        <h1
          class="font-willywonka text-9xl md:text-[170px] font-normal text-wonka-yellow my-2 leading-[0.8] tracking-normal transition-transform duration-500 hover:scale-105 hover:rotate-2 drop-shadow-[0_8px_0_rgba(133,77,14,0.8)] filter"
          style="-webkit-text-stroke:3px #854d0e"
        >
          Golden Byte
        </h1>
      </div>
    </div>

    <!-- Countdown -->
    <div class="mt-8 flex flex-col items-center">
      <Countdown client:only="react" />
    </div>

    <!-- Golden ticket placeholder -->
    <div class="mt-12 w-64 h-32 md:w-[480px] md:h-[240px] bg-transparent mx-auto animate-float-slow relative">
      <div class="absolute inset-0 bg-yellow-400/20 blur-[60px] rounded-full transform scale-75"></div>
    </div>
  </div>
</div>
