---
import { FooterBed } from "./pixel/GardenBeds";
import { EVENT_YEAR } from "@/lib/event";
import { INTEREST_URL, JUDGE_URL, PORTAL_HACKATHON_URL, PORTAL_ORIGIN } from "@/lib/links";

interface Props {
  /** The 404's bare soil is the point of that page, so it gets no bed in bloom under it. */
  home?: boolean;
}
const { home = false } = Astro.props;

const navIds = ["about", "tracks", "prizes", "schedule", "sponsors", "faqs"];
---

<footer class="relative w-full overflow-hidden">
  <div class:list={["wrap pb-10", home ? "pt-12 md:pt-24" : "pt-2"]}>
    {home && (
      <>
        <h2 class="display -ml-[0.125em] text-[32px] md:text-[40px] lg:text-[56px] xl:text-[72px] leading-[1.05] mb-8">
          Applications open soon
        </h2>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 mb-16">
          <a
            href={INTEREST_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Notify me (opens a sign-up form)"
            class="btn btn-bloom"
          >
            Notify me
          </a>
          <p class="font-sans text-[17px] text-ink-2 max-w-sm leading-relaxed">
            We’ll let you know the moment they do
          </p>
        </div>
      </>
    )}

    {/* Two rows at every width: side by side, the links wrapped FAQ and
         "MLH Code of Conduct" onto lines of their own even at 1440px. */}
    <div class:list={["flex flex-col gap-4 pt-8", home && "border-t border-rule"]}>
      <nav class="grid grid-cols-3 gap-x-6 sm:flex sm:flex-wrap">
        {navIds.map((id) => (
          <a
            href={`/#${id}`}
            class="font-sans text-[15px] capitalize text-ink-2 hover:text-ink transition-colors inline-flex min-h-11 min-w-11 items-center"
          >
            {id === "faqs" ? "FAQ" : id}
          </a>
        ))}
      </nav>

      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-0 sm:gap-x-8 whitespace-nowrap">
        <a
          href={PORTAL_HACKATHON_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="font-sans text-[15px] text-ink-2 hover:text-ink transition-colors inline-flex min-h-11 items-center"
        >
          Hacker portal
        </a>
        <a
          href={JUDGE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="font-sans text-[15px] text-ink-2 hover:text-ink transition-colors inline-flex min-h-11 items-center"
        >
          Judge Hacklytics
        </a>
        <a
          href="mailto:hello@hacklytics.io"
          class="font-sans text-[15px] text-ink-2 hover:text-ink transition-colors inline-flex min-h-11 items-center"
        >
          hello@hacklytics.io
        </a>
        <a
          href={PORTAL_ORIGIN}
          target="_blank"
          rel="noopener noreferrer"
          class="font-sans text-[15px] text-ink-2 hover:text-ink transition-colors inline-flex min-h-11 items-center"
        >
          datasciencegt.org
        </a>
        <a
          href="https://static.mlh.io/docs/mlh-code-of-conduct.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="font-sans text-[15px] text-ink-2 hover:text-ink transition-colors inline-flex min-h-11 items-center"
        >
          MLH Code of Conduct
        </a>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <p class="font-sans text-[13px] text-ink-3">© {EVENT_YEAR} Data Science @ GT</p>
      <div class="flex items-center gap-5">
        <a
          href="https://instagram.com/dsgt"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="font-sans text-[13px] text-ink-3 hover:text-ink transition-colors inline-flex min-h-11 items-center"
        >
          Instagram
        </a>
        <a
          href="https://linkedin.com/company/dsgt"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="font-sans text-[13px] text-ink-3 hover:text-ink transition-colors inline-flex min-h-11 items-center"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>

  {/* The page ends in the same bed it started in. */}
  {home && (
    <>
      <h2 class="wrap font-display text-[16px] text-ink pt-10">Plant a flower</h2>
      <FooterBed client:visible />
    </>
  )}
</footer>
