---
import "../styles/fonts.generated.css";
import "../styles/globals.css";
import EventLayout from "@query/event-kit/components/Layout.astro";
import { FooterBed, MenuBed } from "../components/pixel/GardenBeds";
import event from "../event.config";
import { FONT_PRELOADS } from "../lib/fonts.generated";

// Fonts: Instrument Sans for text and UI, Silkscreen for display type (hero,
// section titles, track names, countdown). Silkscreen has one weight, so
// nothing sets it bold: a synthesized bold smears the pixel cells. Both come
// from scripts/subset-fonts.py, which says when to rerun it.

interface Props {
  /** Whether this is the home page; the footer's call to action and bed only belong there. */
  home?: boolean;
}
const { home = false } = Astro.props;
---

<EventLayout event={event} home={home} fontPreloads={FONT_PRELOADS}>
  <slot name="head" slot="head" />
  {/* The menu only opens below 1024px, so its bed hydrates only there. */}
  <Fragment slot="menu-art">
    <MenuBed client:media="(max-width: 1023px)" start={event.startMs} />
  </Fragment>
  {/* The page ends in the same bed it started in. */}
  {home && (
    <Fragment slot="footer-art">
      <h2 class="wrap font-display text-[16px] text-ink pt-10">Plant a flower</h2>
      <FooterBed client:visible start={event.startMs} />
    </Fragment>
  )}
  <slot />
</EventLayout>
