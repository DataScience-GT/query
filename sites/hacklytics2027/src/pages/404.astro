---
import MlhBadge from "../components/MlhBadge.astro";
import { NotFoundBed } from "../components/pixel/GardenBeds";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  {/* "Nothing grows at this address", so the soil here is bare, the only bed
      on the site with no plants, until a visitor plants the first one. */}
  <main class="relative flex min-h-[100svh] flex-col">
    <MlhBadge />

    <div class="wrap flex flex-1 flex-col items-center justify-center pt-28 md:pt-40 short:pt-24 pb-10 text-center">
      <p class="kicker text-[17px] md:text-[20px] leading-7 text-ink">Page not found</p>
      <h1 class="display text-[120px] md:text-[192px] short:text-[128px] mt-4 -translate-x-[0.0625em]">
        404
      </h1>
      <p class="font-sans text-[17px] md:text-[19px] text-ink-2 leading-[1.55] max-w-[40ch] mt-6">
        Nothing grows at this address. The page may have moved, or it never
        existed.
      </p>
      <div class="mt-8">
        <a href="/" class="btn btn-bloom">Go to the homepage</a>
      </div>
    </div>

    <div class="pb-6">
      <NotFoundBed client:visible />
    </div>
  </main>
</Layout>
