{
  "name": "@query/eslint-config",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./next-js": "./next.js",
    "./react": "./react.js",
    "./react-internal": "./react-internal.js"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/compat": "1.2.0",
    "@eslint/js": "9.17.0",
    "@next/eslint-plugin-next": "16.3.6",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-turbo": "^2.11.3",
    "globals": "15.14.0",
    "minimatch": "10.2.6",
    "typescript-eslint": "8.70.1"
  },
  "devDependencies": {
    "@query/prettier-config": "workspace:*",
    "@query/tsconfig": "workspace:*",
    "@types/eslint__js": "8.42.3",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.2"
  },
  "prettier": "@query/prettier-config"
}
