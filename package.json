{
  "name": "query",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "node tooling/scripts/src/guard-local.ts && vitest run tooling/scripts packages/api packages/auth packages/db sites/mainweb/lib sites/mainweb/components packages/ui",
    "local:up": "node tooling/scripts/src/local.ts up",
    "local:down": "node tooling/scripts/src/local.ts down",
    "local:reset": "node tooling/scripts/src/local.ts reset"
  },
  "dependencies": {
    "next": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
