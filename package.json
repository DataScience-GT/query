{
  "name": "query",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "sites/*",
    "packages/*",
    "tooling/*"
  ],
  "engines": {
    "node": ">=20.16.0 <23"
  },
  "scripts": {
    "dev": "pnpm turbo run dev --parallel",
    "dev:mainweb": "pnpm turbo run dev --filter=web",
    "dev:full": "pnpm turbo run dev --parallel",
    "build:mainweb": "pnpm turbo run build --filter=web",
    "build": "pnpm turbo run build",
    "start": "pnpm turbo run start",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "pnpm turbo run clean",
    "lint": "pnpm turbo run lint",
    "lint:fix": "pnpm turbo run lint -- --fix",
    "format": "pnpm turbo run format",
    "format:fix": "pnpm turbo run format -- --write",
    "typecheck": "pnpm turbo run typecheck"
  },
  "dependencies": {
    "@query/db": "*",
    "@tanstack/react-router": "1.145.7",
    "autoprefixer": "10.4.22",
    "chart.js": "4.5.1",
    "csv-parse": "6.1.0",
    "lucide-react": "^1.14.0",
    "minimatch": "10.2.3",
    "next": "16.2.3",
    "postcss": "8.5.14",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@query/eslint-config": "*",
    "@query/prettier-config": "*",
    "@query/tailwind-config": "*",
    "@query/tsconfig": "*",
    "@tailwindcss/postcss": "4.1.8",
    "@tanstack/react-query": "5.90.12",
    "@trpc/client": "11.15.1",
    "@trpc/react-query": "11.15.1",
    "@trpc/server": "11.15.1",
    "@turbo/gen": "2.6.0",
    "@types/node": "22.15.32",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "turbo": "2.9.9",
    "typescript": "5.8.3"
  },
  "prettier": "@query/prettier-config",
  "resolutions": {
    "basic-ftp": ">=5.2.0",
    "minimatch": ">=10.2.3",
    "next": "16.2.3",
    "js-yaml": ">=4.1.0",
    "esbuild": ">=0.25.0",
    "qs": ">=6.14.2",
    "tmp": ">=0.2.3",
    "rollup": ">=4.59.0",
    "immutable": ">=5.1.5",
    "undici": ">=6.24.0",
    "flatted": ">=3.3.2",
    "picomatch": ">=4.0.0",
    "handlebars": ">=4.7.9",
    "brace-expansion": ">=2.0.1",
    "nodemailer": ">=6.9.16",
    "ipaddr.js": ">=2.2.0",
    "typescript": "^5.8.3",
    "eslint": "9.24.0",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.0.3"
  }
}
