    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "turbo run format",
    "format:fix": "turbo run format -- --write",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "dependencies": {
    "@tanstack/react-router": "1.145.7",
    "autoprefixer": "10.4.22",
