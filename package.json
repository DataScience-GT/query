    "lucide-react": "^1.14.0",
    "minimatch": "10.2.3",
    "next": "16.2.3",
    "postcss": "8.5.14",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.8",
    "@tanstack/react-query": "5.90.12",
    "@trpc/client": "11.15.1",
    "@trpc/react-query": "11.15.1",
    "@trpc/server": "11.15.1",
    "@turbo/gen": "2.6.0",
    "@types/node": "22.15.32",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "9.17.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "turbo": "2.9.9",
    "typescript": "5.8.3"
  },
