{
  "name": "query",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "node tooling/scripts/src/guard-local.ts && vitest run tooling/scripts packages/api packages/auth packages/db sites/mainweb/lib sites/mainweb/components",
    "local:up": "node tooling/scripts/src/local.ts up",
    "local:down": "node tooling/scripts/src/local.ts down",
    "local:reset": "node tooling/scripts/src/local.ts reset"
  },
  "dependencies": {
    "next": "16.4.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "esbuild": "^0.25.12",
      "ws": "^8.20.1",
      "@auth/core": "^0.41.3",
      "@grpc/grpc-js": "^1.14.4",
      "websocket-driver": "^0.7.5",
      "protobufjs": "^7.6.5",
      "js-yaml": "^4.3.0",
      "undici": "^6.27.0",
      "sharp": "^0.35.0",
      "vite": "^7.3.7",
      "brace-expansion": "^5.0.9",
      "gaxios>uuid": "^11.1.1",
      "source-map-js": "^1.2.2"
    }
  }
}
